[Unit]
Description=loglady: the Pi's exclusive UART link to Teletype (grid + keyboard), replaces the USB gadget
After=sound.target
Before=grid-macros.service keyboard-forward.service

[Service]
Type=simple
User=ahab
Environment=PYTHONUNBUFFERED=1
RuntimeDirectory=loglady
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/python3 /home/ahab/xiao-uart/loglady_teletype.py --dev /dev/ttyAMA5 --baud 1000000
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
