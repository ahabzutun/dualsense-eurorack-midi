[Unit]
Description=DualSense to MIDI Controller
After=network.target sound.target

[Service]
Type=simple
User=ahab
WorkingDirectory=/home/ahab/dualsense-eurorack-midi
ExecStart=/usr/bin/python3 /home/ahab/dualsense-eurorack-midi/src/dualsense_midi.py
Restart=always
RestartSec=5
# Safety ceiling: restart the service if RSS exceeds 400 MB.
# Residual pymalloc arena growth from pydualsense's 250Hz HID read loop
# accumulates at ~88 MB/hr. At 400 MB the service auto-restarts cleanly
# (Restart=always) rather than running out of memory after many hours.
# The restart takes ~5s and preserves all eurorack hardware state.
MemoryMax=400M
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
# NOTE: PYTHONMALLOC=malloc was tested here and REVERTED.
# tracemalloc confirmed the Python heap is stable after ~60s warmup — growth
# was entirely evdev InputEvent objects recycled within pymalloc arenas (never
# actually retained). PYTHONMALLOC=malloc bypasses pymalloc's arenas and
# exposes every alloc/free to libc, which caused RSS to grow ~840 KB/10s
# continuously even though no objects were actually being leaked.
# pymalloc + gc.set_threshold(200,5,2) + malloc_trim handles this correctly.

[Install]
WantedBy=multi-user.target
